# MyWeb 环境变量示例
# 复制为 `.env` 后使用。按「必须 → 推荐 → 可选」三档分类，重要配置在前。
# 每一项均注明「不配置时的默认值」，未标注默认值的项才需要显式设置。

######################### 一、必须配置 #########################
# 生产环境（NODE_ENV=production）缺失以下两项时，后端会拒绝启动（process.exit(1)）。
# 开发环境（NODE_ENV=development）不强制，密码门也不启用。

# 运行模式：production / development（不配置默认 development）。
# 决定密码门是否启用、日志级别等行为；Docker 镜像内已硬编码为 production。
NODE_ENV=development

# 访问密码：整个应用的登录口令。无默认值，生产必须设置。
APP_PASSWORD=

# 访问 cookie 签名密钥：建议为 32 位以上随机字符串。无默认值，生产必须设置。
# （开发环境未配置时会临时回退用 APP_PASSWORD 的值签名，生产环境不允许该回退）
APP_AUTH_SECRET=

######################### 二、推荐配置 #########################
# 不配置也能启动，但生产环境建议显式设置，否则可能出现跨域不可达或端口冲突。

# 允许的前端来源（逗号分隔）。
# 不配置时默认仅放行本地开发地址：
#   http://localhost:3000, http://127.0.0.1:3000,
#   http://localhost:5173, http://127.0.0.1:5173
# 生产环境必须列出真实域名，否则浏览器跨域请求会被拦截；不要使用 *。
CORS_ORIGIN=

# 后端监听端口。优先级 PORT > BACKEND_PORT，均未配置时默认 3000。
# docker-compose 内部会强制 PORT=3000，一般无需改动。
BACKEND_PORT=3000
PORT=3000

# 前端 dev server 端口（仅本地开发生效，生产构建不受影响）。默认 5173。
FRONTEND_PORT=5173

# 前端 API 基础路径。不配置默认 /api（同域部署保持默认即可）。
# 若后端与前端不同域（如 https://api.example.com），需改为完整地址；
# 该值同时会被后端读入 CSP connect-src 白名单（仅 http(s):// 开头的值生效）。
VITE_API_BASE=/api

# 数据库 SQLite 文件路径。不配置时默认 <repo>/server/data/myweb.db。
# 容器部署脚本通常会覆盖此项，本地开发一般无需设置。
DB_PATH=

######################### 三、可选配置 #########################
# 以下均有合理默认值，按需调整即可。

# ---- 安全相关 ----
# 生产环境开启更严格的安全头（HSTS + CSP upgrade-insecure-requests）。
# 不配置默认关闭；仅当值为 1 时开启。
ENABLE_HTTPS_SECURITY=0

# 接口限流：15 分钟窗口内单 IP 最大请求数。非法值回退 1000。
RATE_LIMIT=1000

# JSON/urlencoded 请求体大小上限（支持 kb/mb/gb 单位）。默认 100mb。
# 文件上传走 multer 独立限制，不受此项影响。
BODY_LIMIT=100mb

# 文件上传类型白名单防护（拒绝 html/svg/js/exe 等可执行/脚本类，
# 并对图片/压缩包/PDF 做魔数校验）。默认开启；设为 true 才会关闭防护，
# 仅在受信任的内部场景才建议关闭。
# FILE_ALLOW_ALL_TYPES=true

# ---- 日志相关 ----
# 写日志文件：默认开启；仅当值为 0 时关闭（test 环境强制关闭）。
LOG_TO_FILE=1

# 日志级别：不配置时按环境自动决定（production→info，development→debug，test→error）。
# 可显式指定：debug / info / warn / error。
LOG_LEVEL=

# 详细调试日志：默认关闭；设 1/true/yes/y/on（不区分大小写）开启 debug 输出。
VERBOSE_LOGGING=0

# ---- 会话相关 ----
# 访问会话有效期（天）。非法/非正数回退 30。
APP_AUTH_TTL_DAYS=30

# 会话 cookie 的 SameSite 策略：不配置默认 lax；
# 可选 lax / strict / none（跨域部署需配合 HTTPS，none 时生产强制 secure）。
APP_AUTH_COOKIE_SAME_SITE=lax

# ---- WebSocket 相关 ----
# 单实例最大 WS 连接数（非法值回退 200）。
WS_MAX_CONNECTIONS=200
# 单连接消息发送频率上限（条/连接）。默认 30。
WS_MSG_RATE_LIMIT=30
# WS 心跳间隔（毫秒）。默认 30000。
WS_HEARTBEAT_INTERVAL=30000

# ---- 上传限制 ----
# 全局单文件上传上限（支持 b/kb/mb/gb/tb 单位）。默认 1gb。
# FILE_MAX_UPLOAD_SIZE=1gb
# 单次请求最多上传文件数。默认 10。
# FILE_MAX_UPLOAD_FILES=100
# 壁纸上传上限。默认 500mb。
# WALLPAPER_MAX_UPLOAD_SIZE=300mb
# 应用图标上传上限。默认 5mb。
# APP_ICON_MAX_UPLOAD_SIZE=100mb
# 留言图片单张上限。默认 5mb。
# MESSAGE_IMAGE_MAX_SIZE=8mb
# 留言图片单次最多张数。默认 5。
# MESSAGE_IMAGE_MAX_FILES=5

# ---- 静态资源缓存 ----
# /uploads 静态文件 Cache-Control 时长（秒）。默认 2592000（30 天）。
UPLOADS_CACHE_MAX_AGE=2592000
