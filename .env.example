# MyWeb 环境变量示例
# 复制为 `.env` 后使用。优先配置最重要、最常改的项。

######################### 生产环境必须 #########################
# 访问密码：未设置时，生产环境会阻止启动
APP_PASSWORD=

# 访问 cookie 签名密钥：生产环境必须单独配置
APP_AUTH_SECRET=APP_AUTH_SECRET_CHANGE_ME

######################### 本地开发 / 联调常用 #########################
FRONTEND_PORT=5173
BACKEND_PORT=3000
PORT=3000

# 前端 API 基础路径；同域开发通常保持 /api 即可
VITE_API_BASE=/api

######################### 常用可选 #########################
# 允许的前端来源；留空时默认放行常见本地开发地址
# 生产环境务必显式列出真实域名（逗号分隔），不要使用 *
CORS_ORIGIN=

# 数据库文件路径；容器/部署脚本可覆盖，平时通常无需改
DB_PATH=

# 生产环境可按需开启更严格的安全头
ENABLE_HTTPS_SECURITY=0

# 接口限流、请求体大小和日志配置
# RATE_LIMIT：15 分钟窗口内单 IP 最大请求数（代码默认 1000）
# BODY_LIMIT：JSON/urlencoded 请求体大小上限（代码默认 100mb）
#             文件上传走 multer 独立限制，不受 BODY_LIMIT 影响
RATE_LIMIT=1000
BODY_LIMIT=100mb
LOG_TO_FILE=1
LOG_LEVEL=
VERBOSE_LOGGING=0

######################### 低频可选 #########################
UPLOADS_CACHE_MAX_AGE=2592000
WS_MAX_CONNECTIONS=200
WS_MSG_RATE_LIMIT=30
WS_HEARTBEAT_INTERVAL=30000

# 文件上传：默认允许所有类型；如需白名单（图片/视频/音频/文档/压缩包）可设为 false
# FILE_ALLOW_ALL_TYPES=false

# 如需调大上传限制，再按需取消注释：
# FILE_MAX_UPLOAD_SIZE=1gb
# FILE_MAX_UPLOAD_FILES=100
# WALLPAPER_MAX_UPLOAD_SIZE=300mb
# APP_ICON_MAX_UPLOAD_SIZE=100mb
# MESSAGE_IMAGE_MAX_SIZE=8mb
# MESSAGE_IMAGE_MAX_FILES=5
